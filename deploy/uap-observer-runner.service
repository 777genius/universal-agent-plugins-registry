[Unit]
Description=UAP reviewed stable-launch runner
Requires=uap-observer-runner.socket
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/uap-observer-venv/bin/python /usr/local/libexec/uap-observer-runner --socket-fd 3
WorkingDirectory=/
KillMode=control-group
Delegate=pids
TimeoutStopSec=10s
Restart=on-failure
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=no
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_CHOWN CAP_SETGID CAP_SETUID
AmbientCapabilities=
SystemCallFilter=@system-service @chown setgid setgroups setuid
SystemCallErrorNumber=EPERM
RestrictRealtime=yes
RemoveIPC=yes
TasksMax=64
MemoryMax=2G
CPUQuota=200%
InaccessiblePaths=-/var/lib/uap-observer/state -/run/uap-observer-signer -/etc/uap-observer-ed25519.key -/var/run/docker.sock -/run/docker.sock
ReadWritePaths=/var/lib/uap-observer/jobs /var/lib/uap-observer/workspaces /var/lib/uap-observer/profiles /var/lib/uap-observer-human/pending /var/lib/uap-observer-human/consumed /var/lib/uap-observer-consent/pending /var/lib/uap-observer-consent/consumed
UMask=0077
