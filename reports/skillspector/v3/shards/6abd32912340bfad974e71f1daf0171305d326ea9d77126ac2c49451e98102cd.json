d","unaccounted":0},{"analyzer_id":"static_yara","completed":1,"failed":0,"partial":0,"planned_work":1,"skipped":0,"status":"completed","unaccounted":0}],"entirely_uninspected_files":0,"fully_inspected_files":1,"grouping_complete":true,"ledger_exceptions":[],"ledger_exceptions_total":0,"original_findings":[],"partially_inspected_files":0,"reasons":[],"reference_evidence_truncated":false,"references":[],"references_total":0,"status":"complete"},"errors":[],"execution":{"acquisition_seconds":0.878687,"analysis_seconds":3.349885,"exit_code":0,"finished_at":"2026-10-31T12:47:45Z","started_at":"2026-10-31T12:47:42Z","state":"completed"},"finding_count":1,"finding_group_count":1,"findings":[{"category":"Excessive Agency","code_snippet":"\n## Session modes\n\n- **Default: persistent headless** (`mode: persistent`). The plugin's own browser on its dedicated profile (the profile reported by `browser_status`): self-launched Chrome, no window, never steals focus, no consent popups. Log in once via `browser_setup`; cookies persist. Use for everything unless there's a reason not to. Pass `headed: true` to watch, and warn the user before any headed launch.\n- **Clean room** (`mode: fresh`). Ephemeral profile, thrown away each session. Use for anonymous checks, hostile links, and \"does it render logged-out?\" verifications — never for anything needing identity.\n- **Existing Chrome** (`mode: existing`) attaches to the user's running Chrome — intrusive (drives the daily browser, sees all tabs). Avoid unless the user explicitly asks. First attach shows Chrome's \"Allow remote debugging?\" consent popup (once per session — click Allow). Agent tabs must be opened with `browser_open_background_tab` (extension-brokered into the collapsed `p","confidence":0.75,"evidence":{},"finding":"no consent","finding_ids":["finding-a712b0d0fd534d3fbe4744022a62e4a3"],"id":"sha256:c6c21d68d2e9d076251627ab043bad04261136d559c9b2521d62cec7f6bd4fa4","intent":null,"line":22,"match_fingerprint":"4b9d13ac603b6b3b7223dbea83ec4db8a7d9cd4c5f75cb33027bd83f42ec46e4","message":"Skill enables autonomous high-impact decisions without human-in-the-loop verification. Critical operations (destructive commands, financial transactions, data deletion) should require explicit user confirmation.","occurrences":[{"finding_id":"finding-a712b0d0fd534d3fbe4744022a62e4a3","line":22,"path":"SKILL.md","start_column":204}],"path":"SKILL.md","pattern":"Autonomous Decision Making","raw_count":1,"remediation":"Add human-in-the-loop confirmation for destructive, irreversible, or high-impact operations. Never auto-execute commands that modify files, send data, or alter system state.","review_status":"unreviewed","rule":"EA2","severity":"MEDIUM","start_column":204,"tags":["Excessive Agency"]}],"findings_truncated":false,"freshness":"current","id":"plugin:community:8f0d7c5e1a41635ac687a376b7b5ab47/browser-policy","kind":"plugin_skill","plugin_path":"","profile":{"digest":"sha256:a73e7c4a9fa0ac563a885c541d207e90dde2e248ca426f7824cf429d725db921","id":"static-standard-v3"},"raw_finding_count":1,"report_digest":"sha256:e36172d57962cbf65e5df39685fa2c619fc2ee273a77b76e2d69e74c7a4a1564","retry":{"attempt_count":1,"disposition":"none","latest_status":"complete","next_attempt_at":null,"next_profile":null,"reason":"complete"},"scanned_at":"2026-10-31T12:47:42Z","scanner":{"id":"skillspector","revision":"f3b25697d76256998ca9d42c198d256258d4c035","version":"2.13.1"},"skill_name":"browser-policy","source":{"content_digest":"sha256:91bd87da01781cf1e73a53d4067c196c480278bc56d87bad869465c4f63dcf87","path":"skills/browser-policy","repository":"0xplayerone/pi-browser-use","revision":"1d6e542adaa488c4c773c3c4a60823059d7da568"},"status":"complete","target_revision":"1d6e542adaa488c4c773c3c4a60823059d7da568"}],"repository":"0xplayerone/pi-browser-use","scanner":{"id":"skillspector","revision":"f3b25697d76256998ca9d42c198d256258d4c035","version":"2.13.1"},"schema_version":3}
