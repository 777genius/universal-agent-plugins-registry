d","unaccounted":0},{"analyzer_id":"static_yara","completed":1,"failed":0,"partial":0,"planned_work":1,"skipped":0,"status":"completed","unaccounted":0}],"entirely_uninspected_files":0,"fully_inspected_files":1,"grouping_complete":true,"ledger_exceptions":[],"ledger_exceptions_total":0,"original_findings":[],"partially_inspected_files":0,"reasons":[],"reference_evidence_truncated":false,"references":[],"references_total":0,"status":"complete"},"errors":[],"execution":{"acquisition_seconds":0.739731,"analysis_seconds":2.588919,"exit_code":0,"finished_at":"2026-10-31T12:39:54Z","started_at":"2026-10-31T12:39:51Z","state":"completed"},"finding_count":1,"finding_group_count":1,"findings":[{"category":"Excessive Agency","code_snippet":"\n## Upload files\n\nAn upload is a short-lived session, not a direct transfer. Call `start_attachment_upload` with an explicit `context` (ask the user if it is ambiguous), keep the returned `task_id`, and pass the resulting `file_uid` values to the tool that consumes them. Files from the inline upload UI come back with `file_uid` values directly. Files from the `fallback_url` must be polled with `get_upload_status` until the status is `ok` and then retained with `confirm_attachment_upload`, within the session window. If it has expired, start a new upload. Never ask the user for a local file path or base64 text; direct large files to the `fallback_url` page.\n\n## Handle results\n","confidence":0.8,"evidence":{},"finding":"Never ask the user","finding_ids":["finding-ff816a07f0dc43a8abc440c78da7e97f"],"id":"sha256:c15efc5035ad43e6a2f9d5546744574f0c172f600f7401800a944f76613fdc9c","intent":null,"line":75,"match_fingerprint":"86cf7205d81e4d6e63ee679308a8f57007d09e1e0736da94173d1e471f2bfc76","message":"Skill enables autonomous high-impact decisions without human-in-the-loop verification. Critical operations (destructive commands, financial transactions, data deletion) should require explicit user confirmation.","occurrences":[{"finding_id":"finding-ff816a07f0dc43a8abc440c78da7e97f","line":75,"path":"SKILL.md","start_column":542}],"path":"SKILL.md","pattern":"Autonomous Decision Making","raw_count":1,"remediation":"Add human-in-the-loop confirmation for destructive, irreversible, or high-impact operations. Never auto-execute commands that modify files, send data, or alter system state.","review_status":"unreviewed","rule":"EA2","severity":"MEDIUM","start_column":542,"tags":["Excessive Agency"]}],"findings_truncated":false,"freshness":"current","id":"plugin:community:154c8c4d9d863c4fb2ba85b7c6beaa48/upwork-workflows","kind":"plugin_skill","plugin_path":"","profile":{"digest":"sha256:a73e7c4a9fa0ac563a885c541d207e90dde2e248ca426f7824cf429d725db921","id":"static-standard-v3"},"raw_finding_count":1,"report_digest":"sha256:48424c97e32927609e4fa87a8e35b837e36b0dd37895211b4b6db1a6cedb594e","retry":{"attempt_count":1,"disposition":"none","latest_status":"complete","next_attempt_at":null,"next_profile":null,"reason":"complete"},"scanned_at":"2026-10-31T12:39:51Z","scanner":{"id":"skillspector","revision":"f3b25697d76256998ca9d42c198d256258d4c035","version":"2.13.1"},"skill_name":"upwork-workflows","source":{"content_digest":"sha256:4562bc21e111b60d08a64160d06d5f785c17f2ce6f9881612f866d08ddf6b2a9","path":"skills/upwork-workflows","repository":"upwork/upwork-agent-plugin","revision":"7908a7e68f4a3c462b4eb5bc884ee69c82ecff59"},"status":"complete","target_revision":"7908a7e68f4a3c462b4eb5bc884ee69c82ecff59"}],"repository":"upwork/upwork-agent-plugin","scanner":{"id":"skillspector","revision":"f3b25697d76256998ca9d42c198d256258d4c035","version":"2.13.1"},"schema_version":3}
