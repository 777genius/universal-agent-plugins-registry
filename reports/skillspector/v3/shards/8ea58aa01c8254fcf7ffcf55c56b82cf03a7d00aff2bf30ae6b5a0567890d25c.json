_count":1,"finding_group_count":1,"findings":[{"category":"Excessive Agency","code_snippet":"\n## Upload files\n\nAn upload is a short-lived session, not a direct transfer. Call `start_attachment_upload` with an explicit `context` (ask the user if it is ambiguous), keep the returned `task_id`, and pass the resulting `file_uid` values to the tool that consumes them. Files from the inline upload UI come back with `file_uid` values directly. Files from the `fallback_url` must be polled with `get_upload_status` until the status is `ok` and then retained with `confirm_attachment_upload`, within the session window. If it has expired, start a new upload. Never ask the user for a local file path or base64 text; direct large files to the `fallback_url` page.\n\n## Handle results\n","confidence":0.8,"evidence":{},"finding":"Never ask the user","finding_ids":["finding-7d37c06158f8400486af95f745a6ee57"],"id":"sha256:c15efc5035ad43e6a2f9d5546744574f0c172f600f7401800a944f76613fdc9c","intent":null,"line":75,"match_fingerprint":"86cf7205d81e4d6e63ee679308a8f57007d09e1e0736da94173d1e471f2bfc76","message":"Skill enables autonomous high-impact decisions without human-in-the-loop verification. Critical operations (destructive commands, financial transactions, data deletion) should require explicit user confirmation.","occurrences":[{"finding_id":"finding-7d37c06158f8400486af95f745a6ee57","line":75,"path":"SKILL.md","start_column":542}],"path":"SKILL.md","pattern":"Autonomous Decision Making","raw_count":1,"remediation":"Add human-in-the-loop confirmation for destructive, irreversible, or high-impact operations. Never auto-execute commands that modify files, send data, or alter system state.","review_status":"unreviewed","rule":"EA2","severity":"MEDIUM","start_column":542,"tags":["Excessive Agency"]}],"findings_truncated":false,"freshness":"current","id":"plugin:community:154c8c4d9d863c4fb2ba85b7c6beaa48/upwork-workflows","kind":"plugin_skill","plugin_path":"","profile":{"digest":"sha25