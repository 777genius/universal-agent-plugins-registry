ion":{"acquisition_seconds":0.817908,"analysis_seconds":1.901928,"exit_code":0,"finished_at":"2026-10-31T06:48:43Z","started_at":"2026-10-31T06:48:40Z","state":"completed"},"finding_count":1,"finding_group_count":1,"findings":[{"category":"Excessive Agency","code_snippet":"\n## Maintain shared context\n\nCompany notes are shared with the organisation and reusable by Lightbringer agents. Explain that scope before saving, and establish intent to save company context; permission to draft a strategy alone is not permission to change organisation settings. Honour permission already given without asking again.\n\nFor an authorised save, use `update_company_context` with write consent, moderator rights, the latest read revision and only the intended fields. Omitted fields remain unchanged; empty strings clear fields. `notes` replaces the complete shared notes text: preserve unrelated material and integrate corrections rather than appending contradictory assertions. Keep evidence, confirmation dates where known and material uncertainty in the brief. `applicant_name` changes the legal applicant setting and can name an unnamed workspace, but does not rename an established workspace. Do not infer a legal applicant-name change from a product or trading name.\n","confidence":0.75,"evidence":{},"finding":"without asking","finding_ids":["finding-106c3b6f90a645c6b9a1802919067947"],"id":"sha256:8dcbbda7a9773ce44117b7e2f43a33a968cab8deec7ab7800637ccde352c8ea7","intent":null,"line":26,"match_fingerprint":"8dc77d3dce9ba1f2672e813265a1b1a0c8594866ef38a4e978bf4f4451795465","message":"Skill enables autonomous high-impact decisions without human-in-the-loop verification. Critical operations (destructive commands, financial transactions, data deletion) should require explicit user confirmation.","occurrences":[{"finding_id":"finding-106c3b6f90a645c6b9a1802919067947","line":26,"path":"SKILL.md","start_column":284}],"path":"SKILL.md","pattern":"Autonomous Decision Making","raw_count":1,"remediation":"Add human-in-the-loop confirmation for destructive, irreversible, or high-impact operations. Never auto-execute commands that modify files, send data, or alter system state.","review_status":"unreviewed","rule":"EA2","severity":"MEDIUM","start_column":284,"tags":["Excessive Agency"]}],"findings_truncated":false,"freshness":"current","id":"plugin:community:e7c9c46ac3cb873a07e41f1909d4e23f/company-context","kind":"plugin_skill","plugin_path":"","profile":{"digest":"sha256:a73e7c4a9fa0ac563a885c541d207e90dde2e248ca426f7824cf429d725db921","id":"static-standard-v3"},"raw_finding_count":1,"report_digest":"sha256:6e2cc50a458fa98c367587e4d9327a26c8a8ee6082e20afd568594d3451810b5","retry":{"attempt_count":1,"disposition":"none","latest_status":"complete","next_attempt_at":null,"next_profile":null,"reason":"complete"},"scanned_at":"2026-10-31T06:48:41Z","scanner":{"id":"skillspector","revision":"f3b25697d76256998ca9d42c198d256258d4c035","version":"2.13.1"},"skill_name":"company-context","source":{"content_digest":"sha256:5ff54368ba1250f8c6edb56f6e0113197485e0c6f4e4c4a5314b2bccf1310eec","path":"skills/company-context","repository":"lightbringer-patents/agent-plugin","revision":"7ef36021c15edc4c23450dfdf64ae3cd6cee4cf8"},"status":"complete","target_revision":"7ef36021c15edc4c23450dfdf64ae3cd6cee4cf8"}],"repository":"lightbringer-patents/agent-plugin","scanner":{"id":"skillspector","revision":"f3b25697d76256998ca9d42c198d256258d4c035","version":"2.13.1"},"schema_version":3}
