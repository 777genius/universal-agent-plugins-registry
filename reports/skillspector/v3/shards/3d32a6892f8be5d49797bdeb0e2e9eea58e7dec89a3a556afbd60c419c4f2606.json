8,"evidence":{},"finding":"flood log","finding_ids":["finding-6a6140c5f02448488d4285c55a900cc4"],"id":"sha256:f5ba7fc6ecc90e40e326a843714b1e49a859d773d2343884f44bb21bd4b37d80","intent":null,"line":49,"match_fingerprint":"20b945c1b12b44f7e0991d81616241a739dacb42702f26db27d925baec0e691b","message":"Output size or generation rate is not bounded. Unbounded output enables denial-of-service through resource exhaustion, log flooding, or context-window stuffing.","occurrences":[{"finding_id":"finding-6a6140c5f02448488d4285c55a900cc4","line":49,"path":"rules/error-handling.md","start_column":26}],"path":"rules/error-handling.md","pattern":"Unbounded Output","raw_count":1,"remediation":"Set explicit limits on output length, generation count, and rate. Use max_tokens and truncation to prevent unbounded output.","review_status":"unreviewed","rule":"OH3","severity":"MEDIUM","start_column":26,"tags":["Output Handling"]},{"category":"Excessive Agency","code_snippet":"\n## Use `ShouldDispatchAfterCommit` inside transactions\n\nWhen you dispatch an event inside a database transaction, `ShouldDispatchAfterCommit` delays dispatch until all open database transactions commit. If a transaction rolls back, Laravel discards the event. The delay affects synchronous and queued listeners. It is not limited to queue timing.\n\n```php\nclass OrderShipped implements ShouldDispatchAfterCommit {}","confidence":0.7,"evidence":{},"finding":"not limited to","finding_ids":["finding-649c27c3473340f1ae16992047fa3707"],"id":"sha256:c440a6f335e7e719f04b6120c35d7a29ffb4f71a131ea7476be19441ee6585f9","intent":null,"line":16,"match_fingerprint":"943d9aae8743c129fe98eb6cc5e984f5e35ceba0b44ce4ca00f42b97f0bf3eaf","message":"Skill's behavior or capabilities extend beyond its stated purpose. Scope creep allows an agent to perform actions unrelated to its documented functionality, increasing the attack surface.","occurrences":[{"finding_id":"finding-649c27c3473340f1ae16992047fa3707","line":16,"path":"rules/events-notifications.blade.php","start_column":262}],"path":"rules/events-notifications.blade.php","pattern":"Scope Creep","raw_count":1,"remediation":"Limit the skill's scope to its documented purpose. Remove instructions that enable the agent to perform actions outside its stated functionality.","review_status":"unreviewed","rule":"EA3","severity":"LOW","start_column":262,"tags":["Excessive Agency"]}],"findings_truncated":false,"freshness":"current","id":"laravel/boost/laravel-best-practices","kind":"standalone_skill","plugin_path":null,"profile":{"digest":"sha256:33e3822d74ce72625cc5b479f4473b515f693890a3818366206a4dbc2b8f509c","id":"static-standard-v3"},"raw_finding_count":15,"report_digest":"sha256:70aa3f7bf9cbea843f34506e453d82095fe143fb7c1d8ca5eb3a3b2c2c234520","retry":{"attempt_count":1,"disposition":"blocked","latest_status":"partial","next_attempt_at":null,"next_profile":null,"reason":"reference_missing"},"scanned_at":"2026-11-06T19:30:03Z","scanner":{"id":"skillspector","revision":"f3b25697d76256998ca9d42c198d256258d4c035","version":"2.13.1"},"skill_name":"laravel-best-practices","source":{"content_digest":"sha256:e544ab8c76124f2d67ed0263fbef31a3753ca6b772eed43a6902d9166f96881e","path":".ai/laravel/skill/laravel-best-practices","repository":"laravel/boost","revision":"1929379ea43f9820abd68006207e89ea0aa17152"},"status":"partial","target_revision":"1929379ea43f9820abd68006207e89ea0aa17152"}],"repository":"laravel/boost","scanner":{"id":"skillspector","revision":"f3b25697d76256998ca9d42c198d256258d4c035","version":"2.13.1"},"schema_version":3}
