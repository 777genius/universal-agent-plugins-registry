],"execution":{"acquisition_seconds":0.845526,"analysis_seconds":3.249141,"exit_code":1,"finished_at":"2026-10-30T17:23:02Z","started_at":"2026-10-30T17:22:59Z","state":"completed"},"finding_count":1,"finding_group_count":1,"findings":[{"category":"System Prompt Leakage","code_snippet":"\nThe hook sweeps on every session:\n\n- A mailbox whose `.joined` has not been touched for 2 days drops off the board. Nothing else changes: it keeps its mail and `send` still reaches it. This is a display rule, not a lifecycle one — with dozens of workspaces per machine, a roster of everyone active in the last month is a wall nobody reads.\n- A mailbox whose `.joined` has not been touched for 30 days moves to `.retired/`. It is **moved, never deleted**, because a stale mailbox can still hold unread mail. Recover one with a single `mv`.\n- An archived message in `read/` older than 30 days is deleted. It has already been acted on, and the mailbox is not a permanent log.\n","confidence":0.85,"evidence":{},"finding":"display rule","finding_ids":["finding-5afdc5307bef49d5a0ddc8d35a388853"],"id":"sha256:72323e8b10139ebddb0c8151b08573ee1068a5e6a4801a81773d5b989e3b1791","intent":null,"line":142,"match_fingerprint":"d890e2550ccded34456234e078a3404c2be33552e69e99a777886aa9e681b23d","message":"Skill contains instructions that could directly expose system prompts, internal rules, or hidden instructions to users or external parties.","occurrences":[{"finding_id":"finding-5afdc5307bef49d5a0ddc8d35a388853","line":142,"path":"SKILL.md","start_column":160}],"path":"SKILL.md","pattern":"Direct Prompt Extraction","raw_count":1,"remediation":"Remove any instructions that reveal, print, or output system prompts or internal rules. System instructions should never be exposed to end users.","review_status":"unreviewed","rule":"P6","severity":"HIGH","start_column":160,"tags":["System Prompt Leakage"]}],"findings_truncated":false,"freshness":"current","id":"plugin:community:53b2d7ee986bfb4bce8d34d3b16868ef/