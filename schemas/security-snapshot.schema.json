{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://777genius.github.io/universal-agent-plugins-registry/schemas/security-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["security_schema_version", "sequence", "publication_id", "source_commit", "generated_at", "expires_at", "complete", "discovery", "scanner", "policy", "coverage", "records"],
  "properties": {
    "security_schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "publication_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "complete": {"const": true},
    "discovery": {"$ref": "#/$defs/discovery"},
    "scanner": {"$ref": "#/$defs/scanner"},
    "policy": {"$ref": "#/$defs/policy"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "records": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "discovery": {
      "type": "object", "additionalProperties": false, "required": ["sequence", "snapshot_digest"],
      "properties": {"sequence": {"type": "integer", "minimum": 1}, "snapshot_digest": {"$ref": "#/$defs/digest"}}
    },
    "scanner": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$", "maxLength": 64}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["subjects", "checked", "unavailable"],
      "properties": {
        "subjects": {"type": "integer", "minimum": 0},
        "checked": {"type": "integer", "minimum": 0},
        "unavailable": {"type": "integer", "minimum": 0}
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["tree_digest", "manifest_digest"],
      "properties": {"tree_digest": {"$ref": "#/$defs/digest"}, "manifest_digest": {"$ref": "#/$defs/digest"}}
    },
    "counts": {
      "type": "object", "additionalProperties": false, "required": ["blocking", "warnings", "total"],
      "properties": {
        "blocking": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "disposition", "severity", "confidence", "category", "path", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z]+[0-9]+$"},
        "disposition": {"enum": ["blocking", "warning"]},
        "severity": {"enum": ["allow", "warn", "deny"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "category": {"type": "string", "minLength": 1, "maxLength": 64},
        "path": {"type": "string", "maxLength": 1024},
        "line": {"type": "integer", "minimum": 1},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "outcome", "counts", "scanned_files", "findings"],
      "properties": {
        "subject": {"$ref": "#/$defs/subject"},
        "outcome": {"enum": ["no_blocking_findings", "warnings", "blocking_findings", "check_unavailable"]},
        "counts": {"$ref": "#/$defs/counts"},
        "scanned_files": {"type": "integer", "minimum": 0},
        "report_digest": {"$ref": "#/$defs/digest"},
        "error_code": {"enum": ["acquisition_failed", "scan_failed"]},
        "findings": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/finding"}}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "check_unavailable"}}},
          "then": {"required": ["error_code"], "not": {"required": ["report_digest"]}},
          "else": {"required": ["report_digest"], "not": {"required": ["error_code"]}}
        }
      ]
    }
  }
}
