{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/directory-snapshot.schema.json",
  "title": "Universal Agent Plugins Directory signed snapshot",
  "allOf": [
    {"$ref": "directory-snapshot-records.schema.json"},
    {
      "if": {"properties": {"sequence": {"maximum": 14}}, "required": ["sequence"]},
      "then": {"properties": {"evidence": {"items": {"$ref": "directory-publication-candidate.schema.json#/$defs/legacyEvidence"}}}},
      "else": {"properties": {"evidence": {"items": {"$ref": "directory-publication-candidate.schema.json#/$defs/wireEvidence"}}}}
    }
  ],
  "$defs": {
    "timestamp": {"$ref": "directory-snapshot-records.schema.json#/$defs/timestamp"},
    "release": {"$ref": "directory-snapshot-records.schema.json#/$defs/release"},
    "distribution": {"$ref": "directory-snapshot-records.schema.json#/$defs/distribution"}
  }
}
