{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/directory-snapshot-v2.schema.json",
  "title": "Universal Agent Plugins Directory signed scoped snapshot v2",
  "type": "object",
  "required": [
    "snapshot_schema_version",
    "sequence",
    "publication_id",
    "source_commit",
    "generated_at",
    "expires_at",
    "products",
    "distributions",
    "evidence",
    "revocations"
  ],
  "properties": {
    "snapshot_schema_version": {
      "const": 2
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "publication_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "directory-publication-candidate.schema.json#/$defs/product"
      }
    },
    "distributions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/distribution"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wireEvidence"
      }
    },
    "revocations": {
      "type": "array",
      "items": {
        "$ref": "directory-publication-candidate.schema.json#/$defs/revocation"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "release": {
      "allOf": [
        {
          "$ref": "directory-publication-candidate.schema.json#/$defs/release"
        },
        {
          "type": "object",
          "properties": {
            "published_at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      ]
    },
    "distribution": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "product_id",
        "kind",
        "status",
        "packager",
        "releases",
        "release_policies"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "id": {
          "$ref": "directory-publication-candidate.schema.json#/$defs/distributionId"
        },
        "product_id": {
          "$ref": "directory-publication-candidate.schema.json#/$defs/id"
        },
        "kind": {
          "enum": [
            "upstream",
            "community_bridge",
            "community"
          ]
        },
        "status": {
          "enum": [
            "active",
            "suspended"
          ]
        },
        "packager": {
          "$ref": "directory-publication-candidate.schema.json#/$defs/id"
        },
        "releases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/release"
          }
        },
        "release_policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "directory-distribution-v2.schema.json#/$defs/policy"
          }
        }
      },
      "additionalProperties": false
    },
    "wireEvidence": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "distribution_id",
        "release_sequence",
        "package_tree_digest",
        "level",
        "outcome",
        "artifact",
        "trust"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/evidenceId"
        },
        "distribution_id": {
          "$ref": "#/$defs/distributionId"
        },
        "release_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "package_tree_digest": {
          "$ref": "#/$defs/digest"
        },
        "level": {
          "enum": [
            "schema",
            "materialization",
            "discovery",
            "runtime",
            "oauth"
          ]
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "inconclusive",
            "not_tested",
            "not_applicable"
          ]
        },
        "client": {
          "enum": [
            "codex",
            "chatgpt",
            "cursor",
            "copilot",
            "vscode",
            "kiro",
            "claude",
            "gemini",
            "opencode",
            "cline",
            "windsurf",
            "grok",
            "kimi",
            "qoder",
            "pi"
          ]
        },
        "client_version": {
          "type": "string",
          "minLength": 1
        },
        "installer_version": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "dependency_identity": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "artifact": {
          "type": "object",
          "required": [
            "repository",
            "revision",
            "path",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "revision": {
              "$ref": "#/$defs/sha"
            },
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          },
          "additionalProperties": false
        },
        "trust": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "workflow",
                "source_ref",
                "source_digest"
              ],
              "properties": {
                "kind": {
                  "const": "github_actions"
                },
                "workflow": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9._-]*/\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"
                },
                "source_ref": {
                  "type": "string",
                  "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"
                },
                "source_digest": {
                  "$ref": "#/$defs/sha"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "reviewed_external"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "scope": {
          "enum": [
            "user",
            "project"
          ]
        },
        "closure_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "const": "schema"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "client"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "enum": [
                  "materialization",
                  "discovery",
                  "runtime",
                  "oauth"
                ]
              }
            }
          },
          "then": {
            "required": [
              "client",
              "client_version",
              "installer_version",
              "os",
              "architecture",
              "observed_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "schema"
              }
            },
            "required": [
              "level"
            ]
          },
          "then": {
            "not": {
              "required": [
                "scope"
              ]
            }
          }
        }
      ]
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "distributionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
