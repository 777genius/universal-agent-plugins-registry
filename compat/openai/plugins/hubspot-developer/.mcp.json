{
  "mcpServers": {
    "hubspot-developer": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/io.github.777genius.agentplugins/runtime/launcher.mjs",
        "mcp",
        "start",
        "--disable-usage-tracking",
        "--ai-agent",
        "agentplugins"
      ],
      "env": {
        "HUBSPOT_CLI_VERSION": "8.15.0",
        "HUBSPOT_MCP_STANDALONE": "false"
      }
    }
  }
}
