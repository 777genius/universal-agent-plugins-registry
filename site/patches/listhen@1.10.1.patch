+'use strict';
+
+// Repo-local listhen TLS adapter. Cryptographic operations stay in maintained
+// selfsigned/X509 and Node crypto/TLS; no forge algorithms are retained.
+const { promises: fs } = require('node:fs');
+const { createPrivateKey } = require('node:crypto');
+const { createSecureContext } = require('node:tls');
+const { isIP } = require('node:net');
+const { generate } = require('selfsigned');
+const { Name } = require('@peculiar/x509');
+
+async function readPem(value) {
+  return value.startsWith('--') ? value : fs.readFile(value, 'utf8');
+}
+
+function attributes(options) {
+  return [
+    ['CN', options.commonName], ['C', options.countryCode],
+    ['ST', options.state], ['L', options.locality],
+    ['O', options.organization], ['OU', options.organizationalUnit],
+    ['1.2.840.113549.1.9.1', options.emailAddress],
+  ].filter(([, value]) => value).map(([shortName, value]) => {
+    const encoded = new Name([{ [shortName]: [{ utf8String: value }] }]).toString();
+    return { shortName, value: encoded.slice(encoded.indexOf('=') + 1) };
+  });
+}
+
+async function generateCertificate(options, extensions, ca) {
+  const notBeforeDate = new Date();
+  const notAfterDate = new Date(notBeforeDate);
+  notAfterDate.setDate(notAfterDate.getDate() + (options.validityDays || 1));
+  const result = await generate(attributes(options), {
+    algorithm: 'sha256', keySize: options.bits || 2048,
+    notBeforeDate, notAfterDate, extensions, ca,
+  });
+  if (typeof options.passphrase === 'string' && options.passphrase.length < 2000) {
+    return {
+      key: createPrivateKey(result.private).export({
+        format: 'pem', type: 'pkcs8', cipher: 'aes-256-cbc',
+        passphrase: options.passphrase,
+      }),
+      cert: result.cert, passphrase: options.passphrase,
+    };
+  }
+  return { key: result.private, cert: result.cert };
+}
+
+exports.resolveCertificate = async function resolveCertificate(input) {
+  const options = typeof input === 'object' && input !== null ? input : {};
+  if (options.key && options.cert) {
+    const resolved = { key: await readPem(options.key), cert: await readPem(options.cert) };
+    if (options.passphrase) resolved.passphrase = options.passphrase;
+    return resolved;
+  }
+  if (options.pfx) {
+    const resolved = { pfx: await fs.readFile(options.pfx), passphrase: options.passphrase || '' };
+    try {
+      createSecureContext(resolved);
+    } catch (cause) {
+      throw new Error(
+        'Node TLS could not load the PFX: ' + cause.message +
+        '. Check the passphrase; re-export legacy RC2 PFX with modern AES encryption.',
+        { cause },
+      );
+    }
+    return resolved;
+  }
+  const defaults = {
+    commonName: 'localhost', countryCode: 'US', state: 'Michigan',
+    locality: 'Berkley', organization: 'Testing Corp', organizationalUnit: 'IT department',
+    validityDays: 1, bits: 2048,
+  };
+  const configured = { ...defaults };
+  for (const [name, value] of Object.entries(options)) {
+    if (value !== undefined && value !== null) configured[name] = value;
+  }
+  let issuer;
+  if (configured.signingKey && configured.signingKeyCert) {
+    issuer = {
+      key: createPrivateKey({
+        key: configured.signingKey, passphrase: configured.signingKeyPassphrase,
+      }).export({ format: 'pem', type: 'pkcs8' }),
+      cert: configured.signingKeyCert,
+    };
+  }
+  const ca = await generateCertificate({ ...configured, commonName: configured.commonName + ' development CA', passphrase: undefined }, [
+    { name: 'basicConstraints', cA: true, critical: true },
+    { name: 'keyUsage', keyCertSign: true, critical: true },
+  ], issuer);
+  const domains = Array.isArray(options.domains) ? options.domains : ['localhost', '127.0.0.1', '::1'];
+  const leaf = await generateCertificate(configured, [
+    { name: 'basicConstraints', cA: false, critical: true },
+    { name: 'keyUsage', digitalSignature: true, keyEncipherment: true, critical: true },
+    { name: 'extKeyUsage', serverAuth: true, clientAuth: true },
+    { name: 'subjectAltName', altNames: domains.map(value => isIP(value)
+      ? { type: 7, ip: value } : { type: 2, value }) },
+  ], { key: ca.key, cert: ca.cert });
+  leaf.cert += '\n' + ca.cert + (issuer ? '\n' + issuer.cert : '');
+  return leaf;
+};
