{
  "name": "universal-agent-plugins-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && node scripts/finalize-csp.mjs",
    "generate": "nuxt generate && node scripts/finalize-404.mjs && node scripts/finalize-csp.mjs",
    "lint": "nuxt prepare && eslint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:contracts": "node --test --experimental-strip-types tests/accessibility.test.ts",
    "test:browser": "playwright test",
    "test:e2e": "playwright test",
    "typecheck": "nuxt prepare && vue-tsc --noEmit",
    "check:generated": "node scripts/check-generated.mjs",
    "check:links": "node scripts/check-generated.mjs"
  },
  "dependencies": {
    "nuxt": "4.6.2",
    "reka-ui": "2.10.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.62.1",
    "eslint": "10.13.0",
    "listhen": "1.10.1",
    "selfsigned": "5.5.0",
    "tinyglobby": "0.2.17",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.9"
  },
  "pnpm": {
    "overrides": {
      "@humanfs/node": "0.16.8",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
      "brace-expansion@>=4.0.0 <6.0.0": "5.0.12",
      "browserslist": "4.28.8",
      "devalue@>=5.0.0 <5.9.4": "5.9.4",
      "esbuild": "0.28.2",
      "immutable@>=5.0.0-beta.1 <5.1.8": "5.1.9",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "postcss-selector-parser": "7.1.6",
      "serialize-javascript@>=7.0.0 <7.1.3": "7.1.4",
      "shell-quote@<1.11.0": "1.11.0",
      "source-map-js@<1.2.2": "1.2.2",
      "svgo@>=4.0.0 <4.1.0": "4.1.0",
      "tar@<=7.5.20": "7.5.22",
      "listhen": "1.10.1",
      "listhen>node-forge": "-",
      "nitropack@2.13.4>globby": "-"
    },
    "packageExtensions": {
      "listhen@1.10.1": {
        "dependencies": {
          "selfsigned": "5.5.0",
          "@peculiar/x509": "1.14.3"
        }
      },
      "nitropack@2.13.4": {
        "dependencies": {
          "tinyglobby": "0.2.17"
        }
      }
    },
    "patchedDependencies": {
      "listhen@1.10.1": "patches/listhen@1.10.1.patch",
      "nitropack@2.13.4": "patches/nitropack@2.13.4.patch"
    }
  }
}
